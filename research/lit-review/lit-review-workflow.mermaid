graph TD
    Start([Start Literature Review]) --> Phase0["Phase 0<br/>Intent Lock<br/>Define scope and purpose"]
    
    Phase0 --> Phase1["Phase 1<br/>Structural Skeleton<br/>Create outline with section bins"]
    
    Phase1 --> Phase2["Phase 2<br/>Evidence Ingestion<br/>Collect raw citations and facts"]
    
    Phase2 -.->|Scope reality check:<br/>Adjust bins| Phase1
    
    Phase2 --> Phase25["Phase 2.5<br/>Annotated Capture<br/>Cluster ideas with abstracts<br/>LLM-Safe Zone"]
    
    Phase25 --> Phase3["Phase 3<br/>Conceptual Synthesis<br/>Transform papers into patterns"]
    
    Phase3 --> Phase4["Phase 4<br/>Comparative Structures<br/>Tables, diagrams, contrasts"]
    
    Phase4 --> Phase5["Phase 5<br/>Gap Extraction<br/>Identify and justify gaps"]
    
    Phase5 -.->|Gap verification:<br/>Targeted search| Phase2
    
    Phase5 --> Phase6["Phase 6<br/>Narrative Polish<br/>Flow and readability"]
    
    Phase6 --> End([Submission Ready Review])
    
    DatabaseSearch["Database Search<br/>PubMed, IEEE, Google Scholar<br/>SciSpace, Semantic Scholar"]
    Snowball["Snowballing<br/>Forward/backward citations<br/>from key papers<br/>Connected Papers"]
    Zotero["Zotero Library<br/>Curated collection"]
    Existing["Existing papers<br/>with/without summaries"]
    LLM["LLM Assistant<br/>Claude, ChatGPT, etc.<br/>Final decisions by human"]
    
    Existing -.-> Zotero
    DatabaseSearch -.-> Zotero
    Snowball -.-> Zotero
    DatabaseSearch -.->|Initial discovery| Phase1
    DatabaseSearch -.->|Keyword search| Phase2
    Snowball -.->|Citation mining| Phase2
    Snowball -.->|Build network| Phase25
    DatabaseSearch -.->|Verify gaps| Phase2
    Zotero -.->|Citations & notes| Phase2
    Zotero -.->|Reference| Phase25
    
    LLM -.->|Organize clusters| Phase25
    LLM -.->|Reorganize synthesis| Phase3
    LLM -.->|Format tables| Phase4
    LLM -.->|Suggest gaps| Phase5
    LLM -.->|Improve flow| Phase6
    
