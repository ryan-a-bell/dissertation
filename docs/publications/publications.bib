@inproceedings{bell_AutomatingAIExpert_2025,
  title = {Automating {{AI Expert Consensus}}: {{Feasibility}} of {{Language Model-Assisted Consensus Methods}} for {{Systems Engineering}}},
  booktitle = {Twenty-{{Second Annual Acquisition Research Symposium}} and {{Innovation Summit}}},
  author = {Bell, Ryan and Longshore, Ryan and Madachy, Raymond},
  year = 2025,
  month = may,
  volume = {3},
  publisher = {Naval Postgraduate School},
  address = {Monterey, CA},
  abstract = {Expert consensus is a critical component of decision-making in systems engineering, where stakeholder input and complex trade-offs must be carefully weighed. Traditionally, consensusbuilding techniques such as the Delphi Method, Nominal Group Technique (NGT), and MultiVoting have been used to aggregate expert human opinions systematically. Constant lingering challenges prove to be deterrents such as time-intensive and extensive coordination efforts required to gather Subject Matter Experts (SMEs). With the advent of Large Language Models (LLMs), there exists the potential to capture the expert knowledge and leverage AI to streamline consensus-building. This conceptual paper explores the feasibility of LLM-assisted consensus methods in the context of systems engineering. We evaluate consensus methods based on their structure, expert interaction requirements, and compatibility with LLMs, followed by identifying which methods could be enhanced through AI-driven automation. Through a comparative analysis, we hypothesize the methods best suited for LLM augmentation or full automation and explore their potential applications in systems engineering. Finally, we discuss future research directions for both AI-driven and hybrid human-AI consensus frameworks. Keywords: Large Language Models (LLMs), Artificial Intelligence (AI), Consensus Methods, Systems Engineering, Feasibility Study},
  file = {files/1423/SYM-AM-25-424.pdf}
}

@article{bell_BalancingAccuracyEfficiencyQuantization_2025,
  title = {Balancing Accuracy and Efficiency: {{Trade-offs}} in Large Language Model Quantization for the Systems Engineering Domain},
  author = {Bell, Ryan and Madachy, Raymond and Longshore, Ryan},
  year = 2025,
  journal = {Wiley INCOSE},
  volume = {Submitted},
  abstract = {As Large Language Models (LLMs) are increasingly deployed within the systems engineering domain, optimizing these models to balance computational efficiency, cost, and performance accuracy becomes essential. One process for balancing efficiency and accuracy for LLMs is quantization, a process that involves converting model parameters from higher precision formats to lower precision formats. This paper presents an empirical study investigating the impact of quantization at varying levels --- 4-bit, 8-bit, 16-bit, and 32-bit floating-point --- on LLM performance specifically within systems engineering contexts. The benchmark for systems engineering tasks, SysEngBench, will be used to evaluate LLM performance. SysEngBench is tailored to the systems engineering domain specific concepts such as requirements, architecture, model-based systems engineering, technical management processes, and specialty engineering activities. By examining accuracy loss across quantization levels, we can glean insight into scenarios where lower bit quantization provides efficiency gains with minimal impact on accuracy as well as scenarios where higher bit quantization levels are paramount for maintaining high fidelity responses. Analysis will be presented on quantization levels versus accuracy versus model size. Results will reveal distinct trade-offs that can guide practitioners in selecting appropriate quantization levels for their desired performance, cost, and resource requirements, which is particularly useful for model deployment in computation-constrained environments.},
  keywords = {Large Language Model (LLM),Performance Benchmarking,Quantization,SysEngBench,Systems Engineering,Trade-Off Study}
}

