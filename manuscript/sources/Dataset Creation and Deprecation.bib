@article{R_Sujay_2024_Question_Complexity_Estimation,
  title = {Multi-Faceted Question Complexity Estimation Targeting Topic Domain-Specificity},
  author = {Sujay, R. and Perumal, Suki and Nagraj, Yash and Ghei, Anushka and SrinivasK, S.},
  year = 2024,
  doi = {10.5121/csit.2024.141513},
  abstract = {Question difficulty estimation remains a multifaceted challenge in educational and assessment settings. Traditional approaches often focus on surface-level linguistic features or learner comprehension levels, neglecting the intricate interplay of factors contributing to question complexity. This paper presents a novel framework for domain-specific question difficulty estimation, leveraging a suite of NLP techniques and knowledge graph analysis. We introduce four key parameters: Topic Retrieval Cost, Topic Salience, Topic Coherence, and Topic Superficiality, each capturing a distinct facet of question complexity within a given subject domain. These parameters are operationalized through topic modelling, knowledge graph analysis, and information retrieval techniques. A model trained on these features demonstrates the efficacy of our approach in predicting question difficulty. By operationalizing these parameters, our framework offers a novel approach to question complexity estimation, paving the way for more effective question generation, assessment design, and adaptive learning systems across diverse academic disciplines.},
  publication_type = {article},
  annotation = {R\_Sujay\_2024\_Question\_Complexity\_Estimation},
  note = {Insights: Question difficulty depends on cognitive and topical relationships, not just surface text; knowledge graph and topic-based features provide domain-aware estimation. \textbar\textbar{} TL;DR: Introduces a domain-specific NLP framework for estimating question difficulty using four topic-level features that improve adaptive assessment design. \textbar\textbar{} Contributions: - Defines four interpretable parameters of complexity: retrieval cost, salience, coherence, and superficiality. - Employs NLP and knowledge graphs to model domain-specific question difficulty. - Demonstrates empirical improvement in difficulty prediction. - Provides tools applicable to adaptive testing and educational content design. \textbar\textbar{} Challenges: - Limited dataset disclosure; generalization not evaluated. - Absence of cross-domain benchmarking. - Lacks detailed error analysis or human correlation study.},
  file = {C:\Users\rabel\Zotero\storage\ITJCPC5K\Sujay et al. - 2024 - Multi-faceted question complexity estimation targeting topic domain-specificity.pdf}
}

