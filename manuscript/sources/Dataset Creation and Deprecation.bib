  doi = {10.48550/arXiv.2412.01020},
  urldate = {2024-12-23},
  abstract = {LLMs demand significant computational resources for both pre-training and fine-tuning, requiring distributed computing capabilities due to their large model sizes \textbackslash cite\textbraceleft sastry2024computing\textbraceright. Their complex architecture poses challenges throughout the entire AI lifecycle, from data collection to deployment and monitoring \textbackslash cite\textbraceleft OECD\_AIlifecycle\textbraceright. Addressing critical AI system challenges, such as explainability, corrigibility, interpretability, and hallucination, necessitates a systematic methodology and rigorous benchmarking \textbackslash cite\textbraceleft guldimann2024complai\textbraceright. To effectively improve AI systems, we must precisely identify systemic vulnerabilities through quantitative evaluation, bolstering system trustworthiness. The enactment of the EU AI Act \textbackslash cite\textbraceleft EUAIAct\textbraceright{} by the European Parliament on March 13, 2024, establishing the first comprehensive EU-wide requirements for the development, deployment, and use of AI systems, further underscores the importance of tools and methodologies such as Z-Inspection. It highlights the need to enrich this methodology with practical benchmarks to effectively address the technical challenges posed by AI systems. To this end, we have launched a project that is part of the AI Safety Bulgaria initiatives \textbackslash cite\textbraceleft AI\_Safety\_Bulgaria\textbraceright, aimed at collecting and categorizing AI benchmarks. This will enable practitioners to identify and utilize these benchmarks throughout the AI system lifecycle.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Distributed Parallel and Cluster Computing},
  note = {Comment: November 2024 v1.0},
  file = {C\:\\Users\\rabel\\Zotero\\storage\\JTXVVVL2\\Ivanov and Penchev - 2024 - AI Benchmarks and Datasets for LLM Evaluation.pdf;C\:\\Users\\rabel\\Zotero\\storage\\JGHF94FQ\\2412.html}
}

