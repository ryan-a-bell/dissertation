@misc{fu_mcq_reasoning_more_confident_when_wrong_2025,
  title = {Multiple {{Choice Questions}}: {{Reasoning Makes Large Language Models}} ({{LLMs}}) {{More Self-Confident Even When They Are Wrong}}},
  shorttitle = {Multiple {{Choice Questions}}},
  author = {Fu, Tairan and Conde, Javier and Mart{\'i}nez, Gonzalo and Grandury, Mar{\'i}a and Reviriego, Pedro},
  year = 2025,
  month = jan,
  number = {arXiv:2501.09775},
  eprint = {2501.09775},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2501.09775},
  urldate = {2025-03-25},
  abstract = {One of the most widely used methods to evaluate LLMs are Multiple Choice Question (MCQ) tests. MCQ benchmarks enable the testing of LLM knowledge on almost any topic at scale as the results can be processed automatically. To help the LLM answer, a few examples called few shots can be included in the prompt. Moreover, the LLM can be asked to answer the question directly with the selected option or to first provide the reasoning and then the selected answer, which is known as chain of thought. In addition to checking whether the selected answer is correct, the evaluation can look at the LLM-estimated probability of its response as an indication of the confidence of the LLM in the response. In this paper, we study how the LLM confidence in its answer depends on whether the model has been asked to answer directly or to provide the reasoning before answering. The results of the evaluation of questions on a wide range of topics in seven different models show that LLMs are more confident in their answers when they provide reasoning before the answer. This occurs regardless of whether the selected answer is correct. Our hypothesis is that this behavior is due to the reasoning that modifies the probability of the selected answer, as the LLM predicts the answer based on the input question and the reasoning that supports the selection made. Therefore, LLM estimated probabilities seem to have intrinsic limitations that should be understood in order to use them in evaluation procedures. Interestingly, the same behavior has been observed in humans, for whom explaining an answer increases confidence in its correctness.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language},
  note = {Insights: Multiple choice questions (MCQs) for evaluating large language models (LLMs) can indicate reasoning capabilities, as the study shows that LLMs exhibit increased self-confidence in their answers when they provide reasoning before selecting an option. This increase in confidence occurs regardless of the correctness of the answer and is more pronounced for questions requiring reasoning. However, the paper suggests that LLM confidence estimates should be used cautiously as performance indicators, necessitating further research to understand their validity. \textbar\textbar{} TL;DR: Large language models exhibit increased self-confidence in their answers when providing reasoning before selecting an option, regardless of correctness, due to reasoning modifying predicted probabilities, highlighting intrinsic limitations in estimated probabilities for evaluation. \textbar\textbar{} Contributions: - The paper evaluates how the self-confidence of large language models (LLMs) in their multiple choice question (MCQ) responses varies based on whether they answer directly or provide reasoning before selecting an option. This study highlights the importance of understanding LLM confidence as a feature that can influence evaluation procedures. - The findings indicate that LLMs tend to exhibit increased confidence in their answers when they engage in reasoning prior to responding, regardless of the correctness of the selected answer. This behavior parallels human cognition, suggesting that further exploration is needed to comprehend the implications of LLM confidence estimates in assessments. \textbar\textbar{} Challenges: - The paper discusses intrinsic limitations of LLM estimated probabilities, suggesting that these limitations should be understood to effectively use them in evaluation procedures. This indicates a challenge in accurately interpreting the confidence levels of LLMs based on their reasoning processes and selected answers. - Another challenge highlighted is the variability in self-confidence of LLMs when responding to multiple-choice questions, which can occur regardless of whether the selected answer is correct or incorrect. This inconsistency raises questions about the reliability of LLMs' confidence levels and their reasoning capabilities across different topics and question types.},
  file = {C\:\\Users\\rabel\\Zotero\\storage\\2426JV8T\\Fu et al. - 2025 - Multiple Choice Questions Reasoning Makes Large Language Models (LLMs) More Self-Confident Even Whe.pdf;C\:\\Users\\rabel\\Zotero\\storage\\5GDD26PI\\2501.html}
}

