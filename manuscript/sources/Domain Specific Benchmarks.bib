@misc{zhouEngiBenchBenchmarkEvaluating2025,
  title = {{{EngiBench}}: {{A Benchmark}} for {{Evaluating Large Language Models}} on {{Engineering Problem Solving}}},
  shorttitle = {{{EngiBench}}},
  author = {Zhou, Xiyuan and Wang, Xinlei and He, Yirui and Wu, Yang and Zou, Ruixi and Cheng, Yuheng and Xie, Yulu and Liu, Wenxuan and Zhao, Huan and Xu, Yan and Gu, Jinjin and Zhao, Junhua},
