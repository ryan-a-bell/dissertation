@misc{Pomales_Measuring_Influencing_Trustworthiness_AI_Enabled_Systems_2025,
  title = {Measuring and Influencing Trustworthiness of {{AI-enabled}} Systems},
  author = {Pomales, Carol and Charnetzki, Elena},
  year = 2025,
  month = sep,
  howpublished = {Developmental Test, Evaluation, and Assessments (DTE\&A) technical briefing},
  note = {Insights: Reframes test and evaluation of AI-enabled systems as a continuous, lifecycle-spanning process and introduces a multidimensional trustworthiness metric to inform risk-informed T\&E planning decisions. \textbar\textbar{} TL;DR: This briefing proposes a quantitative trustworthiness metric, aligned with NIST AI RMF and DoD CT\&E principles, to guide when, how, and how much testing is needed for AI-enabled systems. \textbar\textbar{} Contributions: - Defines trustworthiness for AI-enabled systems using DoD-adopted NIST definitions, clearly distinguishing trust from trustworthiness (pp. 5--6). - Introduces a multidimensional trustworthiness metric tied to concrete lifecycle activities and engineering decisions rather than model performance alone (pp. 6--7). - Maps trustworthiness assessments to specific T\&E recommendations across acquisition phases, from prototyping through sustainment (pp. 7--10). - Provides detailed derived-requirements and user-story checklists covering explainability, bias mitigation, logging, retraining, cybersecurity, privacy, and operational bounds (pp. 9--10). - Positions trustworthiness measurement as an input to test strategy and test planning, enabling more efficient and repeatable T\&E (pp. 10--12). \textbar\textbar{} Challenges: - Metric execution depends on availability and quality of program documentation and lifecycle artifacts. - Requires cross-functional collaboration among PMs, testers, AI SMEs, and cybersecurity experts. - Automation of trustworthiness assessment is still immature and tool-dependent. - Scaling consistent trustworthiness evaluations across diverse AI-enabled programs remains an open challenge.
\par
MITRE support to OUSD(R\&E), DTE\&A. Distribution Statement A: Approved for Public Release; Distribution Unlimited. DOPSAR Case 25-T-3150
\par
NOTIONAL PARAGRAPH. CHECK IT.
\par
Building on Pomales' argument that T\&E for AI-enabled systems should shift from a one-time performance check to a lifecycle process that produces evidence to inform risk, our meta-evaluation of SysEngBench treats \emph{question format} (MCQ vs. OSQ) as an evaluation design choice that materially influences the trustworthiness evidence we generate. In particular, MCQs can inflate apparent capability by constraining the response space and rewarding recognition over synthesis, while OSQs better expose failure modes that matter in systems engineering practice---such as incomplete requirement decomposition, brittle reasoning under constraints, and plausible-but-wrong artifact generation. By comparing MCQ and OSQ scoring regimes on the same underlying SysEng tasks, we evaluate not just model outputs but the \emph{evaluation itself}: whether it reliably discriminates competence, surfaces risk-relevant errors, and supports repeatable, decision-useful assurance claims. This aligns with Pomales' emphasis on measurable, actionable recommendations for testing strategy---here, recommending when MCQ-style evaluation is appropriate for fast screening and when OSQ-style evaluation is necessary to capture operationally meaningful correctness, robustness, and human-overtrust risks in AI-assisted systems engineering.},
  file = {C:\Users\rabel\Zotero\storage\273M46TV\Pomales and Charnetzki - 2025 - Measuring and influencing trustworthiness of AI-enabled systems.pdf}
}

@misc{Szajnfarber_SERC_Perspective_AI4SE_SE4AI_2025,
  title = {{{SERC}} Perspective: {{AI4SE}} \& {{SE4AI}} 2025},
  author = {Szajnfarber, Zoe},
  year = 2025,
  month = sep,
  howpublished = {Systems Engineering Research Center (SERC) / Acquisition Innovation Research Center (AIRC) presentation},
  note = {\subsection{2. Paragraph you can directly use in your paper}

\par
Here is a \textbf{tight, publication-ready paragraph} that ties \textbf{Pomales + Szajnfarber + SysEngBench + MCQ vs. OSQ} together cleanly:
\par
\begin{quotation}

\par
Szajnfarber emphasizes that AI capability cannot be evaluated independently of how it is embedded in systems engineering workflows, noting that identical AI technologies can exhibit ``very different performance--risk tradeoffs'' depending on interaction structure and task integration . Framed this way, the distinction between multiple-choice questions (MCQs) and open-structured questions (OSQs) in SysEngBench is not merely a matter of difficulty, but a meta-evaluation of evaluation design itself. MCQs impose a highly structured interaction that constrains the response space and primarily tests syntactic recognition, analogous to ``AI in the background'' workflow integration. In contrast, OSQs require models to synthesize, structure, and justify systems engineering artifacts, exposing semantic gaps, brittle reasoning, and human--AI trust calibration risks that arise in realistic AI4SE settings. By comparing MCQ and OSQ performance on identical underlying systems engineering tasks, our work evaluates whether an evaluation regime produces decision-useful evidence about capability, robustness, and failure modes---aligning with Szajnfarber's call to assess AI not as an isolated capability, but as a component of a socio-technical system whose trustworthiness depends on workflow context.
\par
\end{quotation}

\subsection{3. One-sentence ``elevator justification'' (useful for reviewers)}

\par
If you want a single killer sentence for rebuttals or introductions:
\par
\begin{quotation}

\par
Following Szajnfarber's argument that AI assessment must account for workflow integration and human--AI interaction, we treat MCQ vs. OSQ comparison as a meta-evaluation of whether an evaluation format itself masks or exposes system-relevant failure modes in AI-assisted systems engineering.
\par
\end{quotation}

\par
