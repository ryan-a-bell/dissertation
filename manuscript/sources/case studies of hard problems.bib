@misc{holmes2024navigating,
  title = {Navigating Uncertainty: {{Enhancing AI}} System Safety through the Integration of Systems Theory, Set Theory and {{R3}}+ Concepts},
  author = {Holmes, Reginald and Kannan, Hanumanthrao},
  year = 2024,
  note = {Boeing 737 Max and the MCAS system from poor problem space definition 
\par
issues included: 
\par
\begin{itemize}

\item larger engines
\item aerodynamic challenge
\item MCAS introduction
\item Minimal re-training

\end{itemize}

\par
Insights: Argues that many AI safety failures stem from poorly defined problem spaces and incomplete hazard analysis, and proposes integrating Systems Theory with Set Theory to formally define safety, completeness, traceability, and R3+ properties in AI-enabled systems.
\par
\textbar\textbar{}
\par
TL;DR: This presentation proposes a formal framework combining Systems Theory and Set Theory to rigorously define AI system safety and distinguish it from robustness, reliability, resilience, and antifragility (R3+).
\par
\textbar\textbar{}
\par
Contributions:
\par
- Uses real-world failures (Cruise robotaxi incident; Boeing 737 MAX MCAS) to demonstrate how inadequate problem space definition leads to safety hazards (pp. 2--6).
\par
- Defines safety as a system-level emergent property distinct from R3+ performance attributes, grounded in Systems Theory (pp. 4, 12).
\par
- Introduces Set Theory as a formal mechanism to ensure unambiguity, traceability, completeness, consistency, and verifiability of safety requirements (pp. 4, 7).
\par
- Formally maps R3+ concepts (robustness, reliability, resilience, antifragility) to systems-theoretic elements such as functions, states, outcomes, and system solutions (pp. 8--9).
\par
- Provides a mathematically grounded definition of robustness for open vs. closed systems, with AI safety as the overarching objective (pp. 10--11).
\par
\textbar\textbar{}
\par
Challenges:
\par
- Formal definitions for reliability, resilience, and antifragility are still under development.
\par
- Translating formal set-theoretic safety models into practical engineering tools remains nontrivial.
\par
- Requires significant systems engineering rigor that may exceed current AI development practices.
\par
- Validation of the framework across diverse AI domains is still needed.
\par
Presented at the AI4SE \& SE4AI Workshop 2024},
  file = {C:\Users\rabel\Zotero\storage\CZ5QU7UZ\Holmes and Kannan - 2024 - Navigating uncertainty Enhancing AI system safety through the integration of systems theory, set th.pdf}
}

@misc{lamparth_HumanVsMachine_2024,
  title = {Human vs. {{Machine}}: {{Behavioral Differences Between Expert Humans}} and {{Language Models}} in {{Wargame Simulations}}},
  shorttitle = {Human vs. {{Machine}}},
  author = {Lamparth, Max and Corso, Anthony and Ganz, Jacob and Mastro, Oriana Skylar and Schneider, Jacquelyn and Trinkunas, Harold},
  year = 2024,
  month = oct,
  number = {arXiv:2403.03407},
  eprint = {2403.03407},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2403.03407},
  urldate = {2026-02-02},
  abstract = {To some, the advent of artificial intelligence (AI) promises better decision-making and increased military effectiveness while reducing the influence of human error and emotions. However, there is still debate about how AI systems, especially large language models (LLMs) that can be applied to many tasks, behave compared to humans in high-stakes military decision-making scenarios with the potential for increased risks towards escalation. To test this potential and scrutinize the use of LLMs for such purposes, we use a new wargame experiment with 214 national security experts designed to examine crisis escalation in a fictional U.S.-China scenario and compare the behavior of human player teams to LLM-simulated team responses in separate simulations. Here, we find that the LLM-simulated responses can be more aggressive and significantly affected by changes in the scenario. We show a considerable high-level agreement in the LLM and human responses and significant quantitative and qualitative differences in individual actions and strategic tendencies. These differences depend on intrinsic biases in LLMs regarding the appropriate level of violence following strategic instructions, the choice of LLM, and whether the LLMs are tasked to decide for a team of players directly or first to simulate dialog between a team of players. When simulating the dialog, the discussions lack quality and maintain a farcical harmony. The LLM simulations cannot account for human player characteristics, showing no significant difference even for extreme traits, such as "pacifist" or "aggressive sociopath." When probing behavioral consistency across individual moves of the simulation, the tested LLMs deviated from each other but generally showed somewhat consistent behavior. Our results motivate policymakers to be cautious before granting autonomy or following AI-based strategy recommendations.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language,Computer Science - Computers and Society},
  note = {Comment: Updated with new human participant results and added new LLM to results; fixed error in Table 1; all claims unaffected
\par
Insights: Provides the first large-scale empirical comparison between expert human teams and LLM-simulated teams in crisis wargames, showing that LLMs often exhibit more aggressive and less context-sensitive behavior despite high-level similarity.
\par
\textbar\textbar{}
\par
TL;DR: This paper finds that while LLMs can approximate aggregate human decision patterns in wargames, they differ significantly in escalation tendencies, dialog quality, and sensitivity to player attributes---raising serious concerns for military use.
\par
\textbar\textbar{}
\par
Contributions:
\par
- Designs and executes a controlled U.S.--China crisis wargame with 214 national security experts and matched LLM-simulated teams (pp. 3--6).
\par
- Demonstrates high-level agreement but systematic action-level divergence between humans and LLMs across 21 decision options (Fig. 2, Table 1).
\par
- Shows that LLMs tend to favor more aggressive options and increased action counts, especially when simulating dialog (Figs. 3--4).
\par
- Finds that LLMs fail to meaningfully account for player background traits, even under extreme persona prompts (Section 4.6).
\par
- Identifies significant behavioral variance across model versions (GPT-3.5, GPT-4, GPT-4o), with GPT-4 closer to human consistency (Table 2).
\par
\textbar\textbar{}
\par
Challenges:
\par
- LLMs exhibit farcical dialog behavior lacking genuine disagreement or deliberation.
\par
- Aggressiveness and escalation tendencies vary unpredictably with prompt structure.
\par
- No behavioral guarantees can be provided for LLM-based decision simulations.
\par
- Results caution strongly against using LLMs as substitutes for human judgment in military decision-making.},
  file = {C\:\\Users\\rabel\\Zotero\\storage\\MZX7JWKA\\Lamparth et al. - 2024 - Human vs. Machine Behavioral Differences Between Expert Humans and Language Models in Wargame Simul.pdf;C\:\\Users\\rabel\\Zotero\\storage\\S2C8KN8Y\\2403.html}
}

@misc{McDermott_Generative_AI_Visualization_Managing_Megaprojects_2025,
  title = {Generative {{AI}}, Visualization, and the Future of Managing Megaprojects},
  author = {McDermott, Tom},
  year = 2025,
  month = sep,
  howpublished = {AIRC--DAU Quarterly Research Forum presentation},
  note = {Acquisition Innovation Research Center (AIRC). DAU Public Affairs approved for public release October 22, 2024. Presented September 19, 2025
\par
Insights: Argues that megaproject failures stem from fat-tailed uncertainty distributions, stakeholder misalignment, and rigidity, and that generative AI combined with interactive visualization can surface early warning signals and support adaptive decision-making. \textbar\textbar{} TL;DR: This presentation shows how integrating LLMs with visualization dashboards can help leaders manage uncertainty, stakeholder dynamics, and complexity in billion-dollar megaprojects. \textbar\textbar{} Contributions: - Synthesizes megaproject risk literature (fat tails, behavioral bias, stakeholder complexity) into a practical uncertainty framework (pp. 3--6). - Introduces a four-context megaproject uncertainty model (system, stakeholder, implementation, strategic) with eight mitigation strategies (p. 6). - Proposes VIS+AI interaction loops (interaction, execution, intelligence optimization) for human--AI collaboration (p. 7). - Maps LLM capabilities across project management tasks from automation to augmentation, highlighting where human judgment remains essential (pp. 8--9). - Demonstrates an AI-enabled uncertainty dashboard and metaphor-based visualization (train metaphor) to improve shared situational awareness among stakeholders (pp. 9--11). \textbar\textbar{} Challenges: - LLM outputs depend heavily on data quality and schema alignment. - Visualization metaphors risk oversimplification if not carefully governed. - Continuous learning systems introduce governance and validation challenges. - Adoption requires cultural change among leaders accustomed to deterministic planning.},
  file = {C:\Users\rabel\Zotero\storage\CGL3A8AQ\McDermott - 2025 - Generative AI, visualization, and the future of managing megaprojects.pdf}
}

@misc{shrivastava_MeasuringFreeFormDecisionMaking_2024,
  title = {Measuring {{Free-Form Decision-Making Inconsistency}} of {{Language Models}} in {{Military Crisis Simulations}}},
  author = {Shrivastava, Aryan and Hullman, Jessica and Lamparth, Max},
  year = 2024,
  month = oct,
  number = {arXiv:2410.13204},
  eprint = {2410.13204},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2410.13204},
  urldate = {2026-02-02},
  abstract = {There is an increasing interest in using language models (LMs) for automated decision-making, with multiple countries actively testing LMs to aid in military crisis decision-making. To scrutinize relying on LM decision-making in high-stakes settings, we examine the inconsistency of responses in a crisis simulation ("wargame"), similar to reported tests conducted by the US military. Prior work illustrated escalatory tendencies and varying levels of aggression among LMs but were constrained to simulations with pre-defined actions. This was due to the challenges associated with quantitatively measuring semantic differences and evaluating natural language decision-making without relying on pre-defined actions. In this work, we query LMs for free form responses and use a metric based on BERTScore to measure response inconsistency quantitatively. Leveraging the benefits of BERTScore, we show that the inconsistency metric is robust to linguistic variations that preserve semantic meaning in a question-answering setting across text lengths. We show that all five tested LMs exhibit levels of inconsistency that indicate semantic differences, even when adjusting the wargame setting, anonymizing involved conflict countries, or adjusting the sampling temperature parameter \$T\$. Further qualitative evaluation shows that models recommend courses of action that share few to no similarities. We also study the impact of different prompt sensitivity variations on inconsistency at temperature \$T = 0\$. We find that inconsistency due to semantically equivalent prompt variations can exceed response inconsistency from temperature sampling for most studied models across different levels of ablations. Given the high-stakes nature of military deployment, we recommend further consideration be taken before using LMs to inform military decisions or other cases of high-stakes decision-making.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language,Computer Science - Computers and Society},
  note = {Insights: Shows that large language models exhibit substantial semantic inconsistency in free-form military decision-making, even under identical prompts, low temperatures, anonymized scenarios, and human oversight assumptions.
\par
\textbar\textbar{}
\par
TL;DR: This paper demonstrates that LLMs produce highly inconsistent and semantically divergent recommendations in military wargames, raising serious concerns about their suitability for high-stakes decision support.
\par
\textbar\textbar{}
\par
Contributions:
\par
- Introduces a BERTScore-based inconsistency metric capable of measuring semantic divergence in free-form LM decisions (Section 3, Fig. 1).
\par
- Conducts controlled military crisis wargames showing all tested LMs generate semantically inconsistent recommendations (Section 5, Fig. 3).
\par
- Demonstrates that prompt sensitivity can induce more inconsistency than temperature-based stochasticity (Section 6, Fig. 7).
\par
- Shows inconsistency persists even at temperature T = 0 and under country anonymization (Sections 5.3--5.4).
\par
- Provides one of the first quantitative evaluations of free-form LM decision volatility in high-stakes military contexts.
\par
\textbar\textbar{}
\par
Challenges:
\par
- Results are based on a single class of crisis scenarios, limiting generalizability.
\par
- Only off-the-shelf foundation models are evaluated; fine-tuned or constrained models may behave differently.
\par
- BERTScore captures semantic differences but cannot assess normative or strategic correctness.
\par
- High inconsistency complicates trust calibration and safe deployment in operational settings.},
  file = {C\:\\Users\\rabel\\Zotero\\storage\\VD72LPKA\\Shrivastava et al. - 2024 - Measuring Free-Form Decision-Making Inconsistency of Language Models in Military Crisis Simulations.pdf;C\:\\Users\\rabel\\Zotero\\storage\\GVYCHFKR\\2410.html}
}
