@article{Shiwen_Ni_2025_Survey_LLM_Benchmarks,
	title = {A survey on large language model benchmarks},
	volume = {abs/2508.15361},
	doi = {10.48550/arxiv.2508.15361},
	abstract = {We systematically review the current status and development of large language model benchmarks for the first time, categorizing 283 representative benchmarks into three categories: general capabilities, domain-specific, and target-specific. We identify inflated scores caused by data contamination, unfair evaluation due to cultural and linguistic biases, and lack of evaluation on process credibility and dynamic environments, and provide a referable design paradigm for future benchmark innovation.},
