@incollection{cook_artificial_2024,
	title = {Artificial {Intelligence} in {Strategic} {Planning} and {Military} {Operations}},
	isbn = {978-1-00-344170-0},
	abstract = {This chapter seeks to identify and address the ethical issues encountered through the expanding use of artificial intelligence (AI) in military strategic planning. This exploration includes the concomitant expansion of operational capabilities integrating an ever-greater degree of AI, such as target-recognition systems, logistics and maintenance management, and autonomous aerial drones. The authors propose to describe each relevant phase of military operations – (i) critical data collection and intelligence gathering, (ii) command and control (C2), and (iii) weapon operations – and the uses and prospective uses of AI therein. This chapter will describe some of the advantages achieved, as well as shortcomings of those AI systems and the issues, both technical and ethical, associated with their use. Ethical use of AI, we contend, confers military advantage through alliances, sustainable usage, and effective private-sector interaction. With audiences of military, political, and technology-sector leaders in mind, this chapter offers new perspectives on the importance of data and data ethics in strategy, current and future use cases, and ethical considerations of different military AI applications.},
	booktitle = {Cyber {Security} in the {Age} of {Artificial} {Intelligence} and {Autonomous} {Weapons}},
	publisher = {CRC Press},
	author = {Cook, James and Helkala, Kirsi and Lucas, George and Pasquale, Frank and Reichberg, Gregory and Syse, Henrik},
