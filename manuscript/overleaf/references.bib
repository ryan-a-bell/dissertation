@article{SUH_complexity_in_engineering_2005,
	title = {Complexity in engineering},
	volume = {54},
	issn = {0007-8506},
	url = {https://www.sciencedirect.com/science/article/pii/S0007850607600195},
	doi = {https://doi.org/10.1016/S0007-8506(07)60019-5},
	abstract = {ABSTRACT In designing and operating engineering systems such as products and manufacturing systems, the goal is to reduce complexity so as to make the system robust, guarantee their long-term stability, make the system reliable, and minimize the cost. In the complexity theory presented in this keynote paper, the complexity is defined as the measure of uncertainty in achieving the functional requirements (FRs) of a system within their specified design range. This definition of complexity leads to the existence of four different types of complexity: time-independent real complexity, time-independent imaginary complexity, time-dependent combinatorial complexity, and time-dependent periodic complexity. According to this complexity theory, complexity of any system can be reduced by taking the following actions: (1) minimize the number of functional requirements (FRs), (2) eliminate the time-independent real complexity, (3) eliminate the time-independent imaginary complexity, (4) transform a system with time-dependent combinatorial complexity into a system with time-dependent periodic complexity by introducing functional periodicity and by reinitializing the system at the beginning of each period. The importance of the functional periodicity in reducing time-dependent combinatorial complexity is illustrated using examples.},
	number = {2},
	journal = {CIRP Annals},
	author = {Suh, Nam P.},
	year = {2005},
	keywords = {axiomatic design, complexity, engineering},
	pages = {46--63},
}

