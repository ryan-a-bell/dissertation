	doi = {10.1609/aaai.v38i16.29767},
	abstract = {New NLP benchmarks are urgently needed to align with the rapid development of LLMs. We present Xiezhi, the most comprehensive evaluation suite designed to assess holistic domain knowledge. Xiezhi comprises 249,587 multiple-choice questions across 516 disciplines and evaluates 47 leading LLMs. Results show that while LLMs outperform humans in STEM fields, they lag in humanities and management domains. All data and code are open-sourced.},
