@book{incose_requirements_working_group_needs_2022,
	edition = {Rev 1.1},
	title = {Needs and {Requirements} {Manual}},
	abstract = {This Needs and Requirements Manual (NRM) presents systems engineering (SE) lifecycle
concepts from the perspective of needs, requirements, verification, and validation (NRVV) 
definition and management across the system lifecycle. Needs, requirements, verification, and 
validation are common threads that tie all lifecycle activities and processes together.
